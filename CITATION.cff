    given-names: Ivan
    alias: "Ivan Bižaca"
repository-code: "https://github.com/ibizaca/cro-bpe"
url: "https://github.com/ibizaca/cro-bpe"
license: Apache-2.0
version: 0.1.0
keywords:
  - tokenizer
  - byte pair encoding
  - Croatian
  - natural language processing
